id = "new-mission"
title = "A New Engineering Ticket"
version = "1.0.0"
order = 155
stage = 2
activity = "write"
duration_minutes = 50
platform = "host"
prerequisites = ["previous-mission"]
objectives = ["Explain the concept", "Implement its boundary behavior"]
starter = "starter"
hints = ["hints/01.md", "hints/02.md", "hints/03.md"]

[content]
briefing = "briefing.md"
lesson = "lesson.md"
debrief = "debrief.md"
solution = "solution.md"

[[checks]]
id = "immutable-c-contract"
name = "Strict build and immutable behavior tests"
type = "c_harness"
sources = ["task.c"]
harness = "checks/test.c"
cflags = ["-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-O0", "-g"]
timeout = 20
required = true
